    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2b8ba65b-c6f2-499e-a93a-8b197d62d8d6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.25" />
