# == Local / CI Vite env (copy to .env.local for local MSAL) == #
# .env.local is gitignored via *.local. Never commit real secrets here —
# these VITE_* values are public in the browser bundle anyway.
#
# Leave VITE_API_BASE_URL empty for local dev so /api stays relative
# and Vite proxies to the local API (see vite.config.ts).

# VITE_API_BASE_URL=https://ca-codesmith-api-001.YOUR_REGION.azurecontainerapps.io

VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT_ID=
VITE_AAD_INSTANCE=https://YOUR_TENANT.ciamlogin.com/
VITE_AAD_API_SCOPE=api://YOUR_API_CLIENT_ID/access
